<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="GAAPerform.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:GAAPerform.Views"
    Shell.FlyoutBehavior="Disabled">

    <TabBar>
        <ShellContent
            Title="Training"
            ContentTemplate="{DataTemplate views:WeekPage}"
            Route="WeekPage"/>
        <ShellContent
            Title="History"
            ContentTemplate="{DataTemplate views:HistoryPage}"
            Route="HistoryPage"/>
        <ShellContent
            Title="Calendar"
            ContentTemplate="{DataTemplate views:CalendarPage}"
            Route="CalendarPage"/>
        <ShellContent
            Title="Report"
            ContentTemplate="{DataTemplate views:ReadinessPage}"
            Route="ReadinessPage"/>
        <ShellContent
            Title="Me"
            ContentTemplate="{DataTemplate views:MePage}"
            Route="MePage"/>
    </TabBar>

</Shell>