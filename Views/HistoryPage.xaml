<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="GAAPerform.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="History"
    BackgroundColor="{StaticResource PageBackground}">

    <ScrollView>
        <VerticalStackLayout Padding="16,12" Spacing="0">
            <Label Text="COMPLETED SESSIONS" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
            <Border Style="{StaticResource Card}">
                <Label Text="No completed sessions yet. Start a session from the Training tab." FontSize="13" TextColor="{StaticResource SecondaryText}" HorizontalOptions="Center"/>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>