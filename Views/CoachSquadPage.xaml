<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="GAAPerform.Views.CoachSquadPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:GAAPerform.Views"
    Title="My Squad"
    BackgroundColor="{StaticResource PageBackground}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <local:BoolToActiveModeConverter x:Key="BoolToActiveModeConverter"/>
            <local:BoolToSelectedStrokeConverter x:Key="BoolToSelectedStrokeConverter"/>
            <local:InverseBoolConverter x:Key="InverseBoolConverter"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="16,12" Spacing="0">

                <!-- Status message -->
                <Border
                    BackgroundColor="#e8f5ee"
                    StrokeThickness="0.5"
                    Stroke="{StaticResource GaaGreen}"
                    StrokeShape="RoundRectangle 8"
                    Padding="12,8"
                    Margin="0,0,0,12"
                    IsVisible="{Binding HasStatus}">
                    <Label Text="{Binding StatusMessage}" FontSize="13" TextColor="{StaticResource GaaGreen}" FontAttributes="Bold"/>
                </Border>

                <!-- Add player -->
                <Label Text="ADD PLAYER TO SQUAD" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Enter the player's email address to add them to your squad." FontSize="13" TextColor="{StaticResource SecondaryText}"/>
                        <Border
                            BackgroundColor="{StaticResource SurfaceBackground}"
                            StrokeThickness="0.5"
                            Stroke="{StaticResource BorderColor}"
                            StrokeShape="RoundRectangle 10"
                            Padding="12,4">
                            <Entry
                                Text="{Binding NewPlayerEmail}"
                                Placeholder="player@email.com"
                                FontSize="15"
                                Keyboard="Email"
                                PlaceholderColor="{StaticResource SecondaryText}"
                                TextColor="{StaticResource PrimaryText}"
                                BackgroundColor="Transparent"/>
                        </Border>
                        <Button
                            Text="Add to Squad"
                            Command="{Binding AddPlayerCommand}"
                            Style="{StaticResource GreenButton}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Squad list -->
                <Label Text="YOUR SQUAD" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>

                <Border Style="{StaticResource Card}"
                    IsVisible="{Binding HasPlayers, Converter={StaticResource InverseBoolConverter}}">
                    <Label
                        Text="No players in your squad yet. Add players above."
                        FontSize="13"
                        TextColor="{StaticResource SecondaryText}"
                        HorizontalOptions="Center"/>
                </Border>

                <CollectionView
                    ItemsSource="{Binding Players}"
                    SelectionMode="None"
                    IsVisible="{Binding HasPlayers}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                        <Label Text="🏃" FontSize="16"/>
                                        <Label Text="{Binding .}" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource PrimaryText}"/>
                                    </VerticalStackLayout>
                                    <Button
                                        Grid.Column="1"
                                        Text="Assign Session"
                                        BackgroundColor="{StaticResource GaaGreen}"
                                        TextColor="White"
                                        FontSize="12"
                                        FontAttributes="Bold"
                                        CornerRadius="8"
                                        HeightRequest="36"
                                        Padding="10,0"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type local:CoachSquadPage}}, Path=BindingContext.SelectPlayerCommand}"
                                        CommandParameter="{Binding .}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Assign session panel -->
                <Border
                    Style="{StaticResource Card}"
                    IsVisible="{Binding ShowAssignPanel}"
                    Margin="0,16,0,0"
                    BackgroundColor="#f0f8f4">
                    <VerticalStackLayout Spacing="12">

                        <Grid ColumnDefinitions="*,Auto">
                            <Label
                                Grid.Column="0"
                                Text="{Binding SelectedPlayerEmail, StringFormat='Assign to: {0}'}"
                                FontSize="14"
                                FontAttributes="Bold"
                                TextColor="{StaticResource GaaGreen}"
                                VerticalOptions="Center"/>
                            <Button
                                Grid.Column="1"
                                Text="✕"
                                BackgroundColor="Transparent"
                                TextColor="{StaticResource SecondaryText}"
                                FontSize="16"
                                Command="{Binding CloseAssignPanelCommand}"/>
                        </Grid>

                        <!-- Session type -->
                        <Label Text="SESSION TYPE" Style="{StaticResource SectionTitle}" Margin="0,4,0,4"/>
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                            <Border Grid.Row="0" Grid.Column="0"
                                BackgroundColor="{Binding IsAssignTraining, Converter={StaticResource BoolToActiveModeConverter}}"
                                StrokeThickness="1.5"
                                Stroke="{Binding IsAssignTraining, Converter={StaticResource BoolToSelectedStrokeConverter}}"
                                StrokeShape="RoundRectangle 10"
                                Padding="8,8">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectEventTypeCommand}" CommandParameter="Training"/>
                                </Border.GestureRecognizers>
                                <Label Text="🏃 Training" FontSize="13" FontAttributes="Bold" HorizontalOptions="Center" TextColor="{StaticResource PrimaryText}"/>
                            </Border>
                            <Border Grid.Row="0" Grid.Column="1"
                                BackgroundColor="{Binding IsAssignMatch, Converter={StaticResource BoolToActiveModeConverter}}"
                                StrokeThickness="1.5"
                                Stroke="{Binding IsAssignMatch, Converter={StaticResource BoolToSelectedStrokeConverter}}"
                                StrokeShape="RoundRectangle 10"
                                Padding="8,8">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectEventTypeCommand}" CommandParameter="Match"/>
                                </Border.GestureRecognizers>
                                <Label Text="⚽ Match" FontSize="13" FontAttributes="Bold" HorizontalOptions="Center" TextColor="{StaticResource PrimaryText}"/>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="0"
                                BackgroundColor="{Binding IsAssignGym, Converter={StaticResource BoolToActiveModeConverter}}"
                                StrokeThickness="1.5"
                                Stroke="{Binding IsAssignGym, Converter={StaticResource BoolToSelectedStrokeConverter}}"
                                StrokeShape="RoundRectangle 10"
                                Padding="8,8">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectEventTypeCommand}" CommandParameter="Gym"/>
                                </Border.GestureRecognizers>
                                <Label Text="💪 Gym" FontSize="13" FontAttributes="Bold" HorizontalOptions="Center" TextColor="{StaticResource PrimaryText}"/>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1"
                                BackgroundColor="{Binding IsAssignRecovery, Converter={StaticResource BoolToActiveModeConverter}}"
                                StrokeThickness="1.5"
                                Stroke="{Binding IsAssignRecovery, Converter={StaticResource BoolToSelectedStrokeConverter}}"
                                StrokeShape="RoundRectangle 10"
                                Padding="8,8">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectEventTypeCommand}" CommandParameter="Recovery"/>
                                </Border.GestureRecognizers>
                                <Label Text="🛌 Recovery" FontSize="13" FontAttributes="Bold" HorizontalOptions="Center" TextColor="{StaticResource PrimaryText}"/>
                            </Border>
                        </Grid>

                        <!-- Session title -->
                        <Label Text="SESSION TITLE" Style="{StaticResource SectionTitle}" Margin="0,4,0,4"/>
                        <Border
                            BackgroundColor="{StaticResource CardBackground}"
                            StrokeThickness="0.5"
                            Stroke="{StaticResource BorderColor}"
                            StrokeShape="RoundRectangle 10"
                            Padding="12,4">
                            <Entry
                                Text="{Binding SessionTitle}"
                                Placeholder="e.g. Tuesday Field Session"
                                FontSize="14"
                                PlaceholderColor="{StaticResource SecondaryText}"
                                TextColor="{StaticResource PrimaryText}"
                                BackgroundColor="Transparent"/>
                        </Border>

                        <!-- Session date -->
                        <Label Text="SESSION DATE" Style="{StaticResource SectionTitle}" Margin="0,4,0,4"/>
                        <Border
                            BackgroundColor="{StaticResource CardBackground}"
                            StrokeThickness="0.5"
                            Stroke="{StaticResource BorderColor}"
                            StrokeShape="RoundRectangle 10"
                            Padding="12,4">
                            <DatePicker
                                Date="{Binding SessionDate}"
                                TextColor="{StaticResource PrimaryText}"
                                BackgroundColor="Transparent"
                                FontSize="14"/>
                        </Border>

                        <!-- Notes -->
                        <Label Text="NOTES (optional)" Style="{StaticResource SectionTitle}" Margin="0,4,0,4"/>
                        <Border
                            BackgroundColor="{StaticResource CardBackground}"
                            StrokeThickness="0.5"
                            Stroke="{StaticResource BorderColor}"
                            StrokeShape="RoundRectangle 10"
                            Padding="12,8">
                            <Editor
                                Text="{Binding SessionNotes}"
                                Placeholder="Instructions for the player..."
                                FontSize="14"
                                PlaceholderColor="{StaticResource SecondaryText}"
                                TextColor="{StaticResource PrimaryText}"
                                BackgroundColor="Transparent"
                                HeightRequest="80"
                                AutoSize="TextChanges"/>
                        </Border>

                        <Button
                            Text="Assign Session"
                            Command="{Binding AssignSessionCommand}"
                            Style="{StaticResource GreenButton}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"/>

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Busy indicator -->
        <ActivityIndicator
            Grid.Row="1"
            IsRunning="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}"
            Color="{StaticResource GaaGreen}"
            Margin="0,8"
            HorizontalOptions="Center"/>

    </Grid>
</ContentPage>