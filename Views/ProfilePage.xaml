<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="GAAPerform.Views.ProfilePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Profile">

    <ScrollView>
        <VerticalStackLayout Padding="16,12" Spacing="8">
            <Label Text="Your Profile" FontSize="20" FontAttributes="Bold" TextColor="#1a5c35"/>
            <Label Text="{Binding SelectedPosition.Title}" FontSize="16"/>
            <Label Text="{Binding SeasonModeTitle}" FontSize="14" TextColor="#6b6b6b"/>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>